{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artist"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "art_pieces": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::art-piece.art-piece",
      "mappedBy": "artist"
    },
    "slug": {
      "type": "uid",
      "targetField": "firstName",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    }
  }
}
