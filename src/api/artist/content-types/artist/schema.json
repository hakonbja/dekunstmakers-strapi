{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artist"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "art_pieces": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::art-piece.art-piece",
      "mappedBy": "artist"
    },
    "slug": {
      "type": "uid",
      "targetField": "firstName",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "title": {
      "type": "string",
      "required": true
    },
    "intro": {
      "type": "string",
      "required": true
    },
    "biography": {
      "type": "richtext",
      "required": true
    },
    "biographyImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
